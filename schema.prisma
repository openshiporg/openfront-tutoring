  familyId           String?          @map("family")
  idempotencyKeyHash String           @unique @default("")
  status             String           @default("pending")
  amount             Int              @default(0)
  currencyCode       String           @default("USD")
  providerPaymentId  String           @default("")
  clientSecret       String           @default("")
  offSession         Boolean          @default(false)
  failureMessage     String           @default("")
  capturedAt         DateTime?
  cancelledAt        DateTime?
  refundedAmount     Int?             @default(0)
  metadata           Json?            @default("{}")
  reviewReason       String           @default("")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  createdBy          User?            @relation("PaymentSession_createdBy", fields: [createdById], references: [id])
  createdById        String?          @map("createdBy")

  @@index([invoiceId])
  @@index([paymentProviderId])
  @@index([familyId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([createdById])
}

model PaymentWebhookEvent {
