  updatedAt       DateTime @default(now()) @updatedAt
  createdBy       User?    @relation("PaymentWebhookEvent_createdBy", fields: [createdById], references: [id])
  createdById     String?  @map("createdBy")

  @@index([createdById])
}

model Task {
  id            String    @id @default(cuid())
  kind          String    @default("manual")
  title         String    @default("")
  family        Family?   @relation("Task_family", fields: [familyId], references: [id])
  familyId      String?   @map("family")
  student       Student?  @relation("Task_student", fields: [studentId], references: [id])
  studentId     String?   @map("student")
  lead          Lead?     @relation("Task_lead", fields: [leadId], references: [id])
  leadId        String?   @map("lead")
  location      Location? @relation("Task_location", fields: [locationId], references: [id])
  locationId    String?   @map("location")
  owner         User?     @relation("Task_owner", fields: [ownerId], references: [id])
  ownerId       String?   @map("owner")
  relatedType   String    @default("")
  relatedId     String    @default("")
  dueAt         DateTime?
  status        String    @default("open")
  openKey       String?   @unique
  outcomeNote   String    @default("")
  completedBy   User?     @relation("Task_completedBy", fields: [completedById], references: [id])
  completedById String?   @map("completedBy")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  createdBy     User?     @relation("Task_createdBy", fields: [createdById], references: [id])
  createdById   String?   @map("createdBy")

  @@index([familyId])
  @@index([studentId])
  @@index([leadId])
  @@index([locationId])
  @@index([ownerId])
  @@index([dueAt])
  @@index([status])
  @@index([completedById])
  @@index([createdById])
}

model Message {
